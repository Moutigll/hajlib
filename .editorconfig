# EditorConfig - https://editorconfig.org
#
# This file tells editors how to format files in this project.
# It is respected by VS Code, Vim, Emacs, CLion, Sublime, etc.
# Always keep this file in sync with the project conventions.

# Mark this as the top-most EditorConfig file.
root = true

# Global settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

# C and headers
[*.{c,h}]
indent_style = tab
indent_size = 4
tab_width = 4

# Assembly (preprocessed .S and raw .s)
[*.{S,s,asm}]
indent_style = tab
indent_size = 4
tab_width = 4

# Makefile
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4
tab_width = 4

# Shell scripts
[*.sh]
indent_style = space
indent_size = 4

# Python (scripts, bench)
[*.py]
indent_style = space
indent_size = 4

# Markdown
[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# YAML / JSON / TOML
[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

# Git config files
[.git*]
indent_style = tab
indent_size = 4

# License and text files
[LICENSE]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
